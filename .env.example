# Required: Groq API key for narrative generation, RAG answers, and the forecast agent.
# Get one at https://console.groq.com
GROQ_API_KEY=gsk_...

# Optional: override the default Groq model (openai/gpt-oss-120b).
# Set this if Groq renames or retires the default model.
GROQ_MODEL=

# Required for fundraising data (FEC bulk download via data.gov or direct FEC API).
# Either key works — the code tries DATA_GOV_API_KEY first, falls back to FEC_API_KEY.
# Get a data.gov key at https://api.data.gov/signup
DATA_GOV_API_KEY=
# Get an FEC key at https://api.open.fec.gov/developers
FEC_API_KEY=

# Required for economic indicators (GDP, unemployment) via FRED.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: protects the FastAPI /refresh endpoint (triggers a full retrain +
# external FEC calls). Leave unset for local/dev use; set it before exposing
# api.py publicly and pass it back as the X-Api-Key header.
REFRESH_API_KEY=
